{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["app", "dmg"],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "infoPlist": "Info.plist",
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true,
      "signingIdentity": "-",
      "bundleName": "Cropmark",
      "dmg": {
        "windowSize": {
          "width": 500,
          "height": 320
        },
        "appPosition": {
          "x": 110,
          "y": 120
        },
        "applicationFolderPosition": {
          "x": 340,
          "y": 120
        }
      }
    }
  }
}
