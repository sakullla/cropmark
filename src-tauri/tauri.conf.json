{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cropmark",
  "version": "0.2.8",
  "identifier": "app.cropmark.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Cropmark",
    "copyright": "Copyright © Cropmark",
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE",
    "category": "Utility",
    "shortDescription": "Cropmark 独立系统截图工具",
    "longDescription": "Cropmark is an independent desktop screenshot tool. Capture a region, window, or screen, annotate, copy or save PNG, and recognize printed Chinese and English offline. Installer, About, and tray use the Cropmark name and icon only.",
    "useLocalToolsDir": true,
    "resources": [
      "models/*"
    ],
    "icon": [
      "icons/v2/32x32.png",
      "icons/v2/128x128.png",
      "icons/v2/128x128@2x.png",
      "icons/v2/icon.icns",
      "icons/v2/icon.ico"
    ]
  }
}
